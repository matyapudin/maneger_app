# Copy to .env.local and adjust. Never commit real secrets (.env.local is git-ignored).

# Where the SQLite database file lives (default: ./data/app.db)
DATABASE_PATH=./data/app.db

# AIMS (Moodle) assignment import: log in from the 課題 screen; no setting needed.
# Only change this to use a different Moodle site.
# MOODLE_BASE_URL=https://aims.aiu.ac.jp

# Gmail import (Google OAuth client, type "Web application"; see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
