# Optional. Copy to .env.local only if you need to change something.
# Normally nothing is needed: AIMS and Google are set up on the 設定 screen.

# Where the SQLite database lives.
# Default: %APPDATA%\maneger_app\app.db on Windows, ~/.maneger_app/app.db elsewhere
# DATABASE_PATH=

# Address the app is opened at (shown as the Google redirect URI on 設定)
# APP_ORIGIN=http://localhost:3000
